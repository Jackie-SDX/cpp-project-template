# Windows MSVC x86 (release leg "Windows MSVC x86").
#
# Compiler versions are the runner images' toolchain of record; bump them
# together with CI image/compiler changes (they key both package IDs and the
# Conan cache key).

[settings]
os=Windows
arch=x86
compiler=msvc
compiler.version=194
compiler.runtime=static
compiler.runtime_type=Release
compiler.cppstd=17
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
# See conanfile.py header: re-assert the project's C++20 after CMakeToolchain
# injects the profile's cppstd as CMAKE_CXX_STANDARD.
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_CXX_STANDARD": "20"}
