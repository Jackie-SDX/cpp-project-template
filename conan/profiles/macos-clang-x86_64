# macOS Homebrew LLVM clang x64 (expanded leg "macOS LLVM x64").
#
# Compiler versions are the runner images' toolchain of record; bump them
# together with CI image/compiler changes (they key both package IDs and the
# Conan cache key).

[settings]
os=Macos
arch=x86_64
compiler=clang
compiler.version=20
compiler.libcxx=libc++
compiler.cppstd=gnu17
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
# See conanfile.py header: re-assert the project's C++20 after CMakeToolchain
# injects the profile's cppstd as CMAKE_CXX_STANDARD.
# Brew LLVM sits next to llvm-ar; CMake then archives with it and the
# GNU-format result is rejected by Apple's linker
# ("archive member '/' not a mach-o file"). Apple's ar/ranlib write the
# BSD format Xcode's ld expects -- pin them (same fix as IREE's macOS
# docs). Applies to both conan package builds and this project.
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_CXX_STANDARD": "20", "CMAKE_AR": "/usr/bin/ar", "CMAKE_RANLIB": "/usr/bin/ranlib"}
# LLVM's bundled libc++ (brew llvm 23) dropped transitive <algorithm>
# includes; wxWidgets 3.2.11's bundled scintilla calls std::fill without
# including it (run 36291616193: SplitVector.h:193, XPM.cxx:91). Force-
# include it for every C++ TU these legs compile (cxxflags = C++ only).
tools.build:cxxflags=["-include", "algorithm"]
# Never auto-install via conan on macOS (brew prompts); CI pre-installs
# whatever wxWidgets system-requirements need (usually nothing).
tools.system.package_manager:mode=check
