# Generated by cmake/WindowsRuntimeDeps.cmake -- do not edit.
#
# Executes the Windows runtime dependency closure step during
# `cmake --install` (and therefore inside CPack staging for the ZIP, NSIS and
# MSI generators). Fails the install when a required DLL is not bundled or a
# payload file has the wrong architecture.

set(_wrt_search_dirs "@_wrt_search_dirs@")
set(_wrt_script "@WRT_SCRIPT@")
set(_wrt_report "@WRT_REPORT@")
set(_wrt_arch "@WRT_ARCH@")
set(_wrt_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")

if(NOT EXISTS "${_wrt_root}")
	message(FATAL_ERROR "Windows runtime closure step: install root does not exist: ${_wrt_root}")
endif()
if(NOT EXISTS "${_wrt_script}")
	message(FATAL_ERROR "Windows runtime closure step: script not found: ${_wrt_script}")
endif()

find_program(_wrt_pwsh NAMES pwsh pwsh.exe)
find_program(_wrt_powershell NAMES powershell powershell.exe)
if(_wrt_pwsh)
	set(_wrt_host "${_wrt_pwsh}")
elseif(_wrt_powershell)
	set(_wrt_host "${_wrt_powershell}")
else()
	message(FATAL_ERROR "Windows runtime closure step: neither pwsh nor powershell is available")
endif()

set(_wrt_args
	-NoProfile
	-ExecutionPolicy Bypass
	-File "${_wrt_script}"
	-Root "${_wrt_root}"
	-ExpectedArch "${_wrt_arch}"
	-Deploy
	-Report "${_wrt_report}"
)
# PowerShell rejects a repeated -SearchDir parameter ("specified more than
# once"), so the entire list is passed as one '|'-joined argument ('|' is
# illegal in Windows path names) and split by the script.
string(REPLACE ";" "|" _wrt_search_dirs_joined "${_wrt_search_dirs}")
list(APPEND _wrt_args -SearchDir "${_wrt_search_dirs_joined}")

execute_process(
	COMMAND "${_wrt_host}" ${_wrt_args}
	RESULT_VARIABLE _wrt_result
	OUTPUT_VARIABLE _wrt_stdout
	ERROR_VARIABLE _wrt_stderr
)
if(NOT _wrt_stdout STREQUAL "")
	message("${_wrt_stdout}")
endif()
if(NOT _wrt_result EQUAL 0)
	if(NOT _wrt_stderr STREQUAL "")
		message("${_wrt_stderr}")
	endif()
	message(FATAL_ERROR "Windows runtime dependency closure step failed with exit code ${_wrt_result}. Report: ${_wrt_report}")
endif()
