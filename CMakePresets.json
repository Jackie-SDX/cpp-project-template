{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Shared settings. Not selectable directly.",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "Default (Ninja, Debug)",
            "description": "Plain Debug build with Ninja.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (Ninja)",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vcpkg-release",
            "inherits": "base",
            "displayName": "Release (Ninja, vcpkg)",
            "description": "Explicit vcpkg-backed Release build. Requires VCPKG_ROOT to point at a vcpkg checkout; manifest mode installs wxwidgets/gtest automatically (vcpkg.json).",
            "generator": "Ninja",
            "toolchainFile": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PACKAGE_MANAGER": "vcpkg"
            }
        },
        {
            "name": "vcpkg-debug",
            "inherits": "base",
            "displayName": "Debug (Ninja, vcpkg)",
            "description": "Explicit vcpkg-backed Debug build. Requires VCPKG_ROOT to point at a vcpkg checkout; manifest mode installs wxwidgets/gtest automatically (vcpkg.json).",
            "generator": "Ninja",
            "toolchainFile": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PACKAGE_MANAGER": "vcpkg"
            }
        },
        {
            "name": "coverage",
            "inherits": "base",
            "displayName": "Coverage",
            "description": "Enables cmake/CodeCoverage.cmake, which requires CMAKE_BUILD_TYPE to be literally 'Coverage'.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Coverage"
            }
        },
        {
            "name": "tidy",
            "inherits": "base",
            "displayName": "Default clang-tidy",
            "description": "Debug build with clang-tidy driven by the .clang-tidy file.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
            }
        },
        {
            "name": "cppcheck",
            "inherits": "base",
            "displayName": "Default cppcheck",
            "description": "Debug build with cppcheck, using CppCheckSuppressions.txt.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_CPPCHECK": "cppcheck;--enable=all;--force;--inline-suppr;--suppressions-list=${sourceDir}/CppCheckSuppressions.txt;--library=wxwidgets"
            }
        }
    ],
    "buildPresets": [
        { "name": "default",  "configurePreset": "default" },
        { "name": "release",  "configurePreset": "release" },
        { "name": "vcpkg-release", "configurePreset": "vcpkg-release" },
        { "name": "vcpkg-debug",    "configurePreset": "vcpkg-debug" },
        { "name": "coverage", "configurePreset": "coverage" },
        { "name": "tidy",     "configurePreset": "tidy" },
        { "name": "cppcheck", "configurePreset": "cppcheck" }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "vcpkg-release",
            "configurePreset": "vcpkg-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "vcpkg-debug",
            "configurePreset": "vcpkg-debug",
            "output": { "outputOnFailure": true }
        }
    ]
}
